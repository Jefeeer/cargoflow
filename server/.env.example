# Server
PORT=3000
NODE_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Notifications (email-ready, no real credentials needed for local demo)
# When NOTIFY_EMAIL is unset, notificationService just logs to the console.
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
